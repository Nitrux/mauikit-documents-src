@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(Qt6 @REQUIRED_QT_VERSION@ COMPONENTS Concurrent Core Quick)
find_dependency(KF6 @REQUIRED_KF_VERSION@ COMPONENTS Archive Config CoreAddons FileMetaData GuiAddons I18n IconThemes KIO)
find_dependency(MauiKit4 @REQUIRED_MAUIKIT_VERSION@ CONFIG)
find_dependency(Poppler COMPONENTS Qt6)
find_dependency(ZLIB)

# Any changes in this ".cmake" file will be overwritten by CMake, the source is the ".cmake.in" file.

set(MauiKitDocuments_INSTALL_PREFIX "@PACKAGE_CMAKE_INSTALL_PREFIX@")

include("${CMAKE_CURRENT_LIST_DIR}/MauiKitDocuments4Targets.cmake")

@PACKAGE_INCLUDE_QCHTARGETS@
